.hero { width: 100%; height: 420rpx; display: block; }

.title { font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 16rpx; }
.big { font-size: 40rpx; }
.sales { color: #999; font-size: 24rpx; }

.section-label { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.content { font-size: 28rpx; line-height: 1.7; color: #444; white-space: pre-wrap; }

.footer { padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); }
.buy-btn { width: 100%; box-sizing: border-box; }

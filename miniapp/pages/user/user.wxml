<view class="page">
  <view class="hero">
    <view class="avatar">{{user ? (user.nickname || '用户') : '未登录'}}</view>
    <view class="sub" wx:if="{{user}}">ID {{user.user_id}}</view>
    <view class="sub" wx:else>浏览无需登录，下单时自动登录</view>
  </view>

  <view class="card menu">
    <view class="mi" bindtap="goOrders">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="mi" bindtap="go" data-url="/pages/refund/refund">
      <text>退款记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="mi" bindtap="go" data-url="/pages/feedback/feedback">
      <text>意见反馈</text>
      <text class="arrow">›</text>
    </view>
    <view class="mi" bindtap="go" data-url="/pages/docs/docs?key=privacy&title=隐私政策">
      <text>隐私政策</text>
      <text class="arrow">›</text>
    </view>
    <view class="mi" bindtap="go" data-url="/pages/docs/docs?key=service-policy&title=服务政策">
      <text>服务政策</text>
      <text class="arrow">›</text>
    </view>
    <view class="mi" bindtap="about">
      <text>关于观星</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>

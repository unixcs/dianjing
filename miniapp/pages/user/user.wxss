.hero {
  background: linear-gradient(135deg, #5b6cff, #4a55e8);
  padding: 60rpx 40rpx 48rpx;
}
.avatar {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}
.sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.menu { padding: 0 24rpx; }
.mi {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  border-bottom: 2rpx solid #f2f3f7;
}
.mi:last-child { border-bottom: none; }
.arrow { color: #ccc; font-size: 32rpx; }

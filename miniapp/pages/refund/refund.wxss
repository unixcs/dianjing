.head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.no { color: #999; font-size: 24rpx; }
.status { color: #ff8f1f; font-size: 24rpx; }
.status-ok { color: #2bb673; }

.title { font-size: 28rpx; }

.bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
.time { color: #999; font-size: 24rpx; }

.reason {
  color: #999;
  font-size: 24rpx;
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

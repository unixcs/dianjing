.wrap { display: flex; height: 100vh; }

.side { width: 180rpx; background: #fff; height: 100%; flex-shrink: 0; }
.side-item {
  padding: 30rpx 20rpx;
  text-align: center;
  color: #666;
  font-size: 26rpx;
  border-left: 6rpx solid transparent;
}
.side-item-active {
  color: #5b6cff;
  border-left-color: #5b6cff;
  background: #f5f6fa;
  font-weight: 600;
}

.main { flex: 1; height: 100%; }

.svc { display: flex; margin: 20rpx; padding: 20rpx; }
.svc-cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; }
.svc-cover-empty {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #6c7bff, #4a55e8);
  color: #fff; font-size: 30rpx;
}
.svc-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.svc-title { font-size: 28rpx; line-height: 1.4; }
.svc-meta { color: #999; font-size: 22rpx; margin-top: auto; }
.svc-price { font-size: 32rpx; margin-top: 8rpx; }

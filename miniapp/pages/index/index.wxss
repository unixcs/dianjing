.banner {
  height: 300rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.banner-img { width: 100%; height: 100%; }

.notice {
  display: flex;
  align-items: center;
  margin: 0 20rpx 20rpx;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}
.notice-label {
  color: #d99a00;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.notice-text {
  color: #8a6100;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cats { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cat-chip {
  background: #eef0ff;
  color: #5b6cff;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 28rpx 24rpx 4rpx;
}

.grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 8rpx; }
.svc { width: 342rpx; margin: 12rpx; box-sizing: border-box; padding: 0 0 20rpx; overflow: hidden; }
.svc-cover { width: 100%; height: 240rpx; display: block; }
.svc-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6c7bff, #4a55e8);
  color: #fff;
  font-size: 40rpx;
  letter-spacing: 8rpx;
}
.svc-title {
  padding: 16rpx 20rpx 8rpx;
  font-size: 28rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.svc-bottom { display: flex; justify-content: space-between; align-items: baseline; padding: 0 20rpx; }
.svc-price { font-size: 32rpx; }
.svc-sales { color: #999; font-size: 22rpx; }

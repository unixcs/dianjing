<view class="pad">
  <view class="btn-primary new-btn" bindtap="toggleForm">{{showForm ? '收起' : '写反馈'}}</view>

  <view class="card form" wx:if="{{showForm}}">
    <view class="types">
      <view class="type {{type === 'complaint' ? 'type-active' : ''}}" bindtap="onType" data-type="complaint">投诉</view>
      <view class="type {{type === 'suggestion' ? 'type-active' : ''}}" bindtap="onType" data-type="suggestion">建议</view>
    </view>
    <textarea
      value="{{content}}"
      bindinput="onContent"
      maxlength="1000"
      placeholder="请描述您遇到的问题或建议（1000 字以内）"
      class="ta"
    />
    <view class="count">{{content.length}}/1000</view>
    <button class="btn-primary submit" disabled="{{submitting}}" bindtap="submit">提交</button>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card item">
    <view class="head">
      <text class="type-tag {{item.type === 'suggestion' ? 'type-tag-sug' : ''}}">{{item.type === 'suggestion' ? '建议' : '投诉'}}</text>
      <text class="state {{item.status === 1 ? 'state-done' : ''}}">{{item.status === 1 ? '已回复' : '待处理'}}</text>
    </view>
    <view class="content">{{item.content}}</view>
    <view class="time">{{item.timeText}}</view>
    <view class="reply" wx:if="{{item.reply}}">
      <view class="reply-label">客服回复</view>
      <view class="reply-text">{{item.reply}}</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!list.length && !showForm}}">暂无反馈记录</view>
</view>

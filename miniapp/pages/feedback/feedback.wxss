.pad { padding-bottom: 40rpx; }

.new-btn { margin: 20rpx; }

.types { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.type {
  padding: 8rpx 36rpx;
  border-radius: 30rpx;
  background: #f2f3f7;
  color: #666;
  font-size: 26rpx;
}
.type-active { background: #eef0ff; color: #5b6cff; font-weight: 600; }

.ta {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.count { text-align: right; color: #bbb; font-size: 22rpx; margin: 8rpx 0 20rpx; }

.head { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.type-tag {
  font-size: 22rpx;
  color: #ff5b3a;
  border: 2rpx solid currentColor;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.type-tag-sug { color: #5b6cff; }
.state { color: #ff8f1f; font-size: 24rpx; }
.state-done { color: #2bb673; }

.content { font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; }
.time { color: #bbb; font-size: 22rpx; margin-top: 12rpx; }

.reply {
  margin-top: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.reply-label { color: #5b6cff; font-size: 24rpx; margin-bottom: 8rpx; }
.reply-text { font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; }

# dianjing backend config example
# cp dianjing.env.example dianjing.env && chmod 600 dianjing.env
# 每个值也可用环境变量覆盖（DJ_* 前缀，见 internal/config/config.go）

LISTEN=127.0.0.1:8096
BASE_URL=https://wx.gxwqb.cn
DATA_DIR=/srv/dianjing/data

# 微信小程序
WX_APP_ID=wx0000000000000000
WX_APP_SECRET=

# 微信虚拟支付 xpay
XPAY_OFFER_ID=1450568898
XPAY_APP_KEY=
XPAY_SANDBOX=1
# 消息推送（GET URL 验证 + 推送验签 + 安全模式回包）
XPAY_PUSH_TOKEN=
XPAY_PUSH_AES_KEY=

# 管理后台（bcrypt hash；生成：go run ./cmd/hashpw -p 你的密码）
ADMIN_PASSWORD_HASH=

# 登录 token 有效期（秒），默认 30 天
TOKEN_TTL=2592000
